# ---------------------------------------------------------------------------
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。
# 所有配置项都通过 ai_agent_platform/settings.py 里的 _load_dotenv() 读取。
# ---------------------------------------------------------------------------

# ---- Django 基础 ----
# 生产环境请替换成随机值：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 模型服务 ----
# DeepSeek（对话主力引擎）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# OpenAI 兼容端点（Agno 框架通过它调用模型）
# 也可以指向 DashScope / 任何 OpenAI 兼容网关
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Agno 平台密钥（可选，仅在使用 Agno 托管能力时需要）
AGNO_API_KEY=

# ---- 可选 ----
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
